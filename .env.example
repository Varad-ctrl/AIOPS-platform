# --- General ---
ENVIRONMENT=development
DEBUG=true

# --- Security / JWT ---
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:password@postgres:5432/aiops_db
DB_ECHO=false

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI / LLM (Module 5.1) ---
# LLM_PROVIDER selects a preset base URL + default model: groq | openai | ollama
# groq is recommended for local development (fast, generous free tier).
LLM_PROVIDER=groq
LLM_API_KEY=
# Only needed if you want to override the provider's preset base URL/model:
LLM_BASE_URL=
LLM_MODEL=
# Back-compat: still read as a fallback if LLM_API_KEY is unset.
OPENAI_API_KEY=

# --- Notifications (Phase 7) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=aiops-assistant@example.com

# --- Monitoring integrations (Phase 2+) ---
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
LOKI_URL=http://loki:3100
JENKINS_URL=
# Optional Jenkins basic-auth credentials (leave blank for anonymous read access)
JENKINS_USER=
JENKINS_API_TOKEN=

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
